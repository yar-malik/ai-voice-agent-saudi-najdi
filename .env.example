# Voho — the speaking half. Create a token at https://app.voho.ai (API Tokens).
VOHO_API_KEY=voho_sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
VOHO_BASE_URL=https://app.voho.ai
# Najdi voices: layla, nouf, faisal, omar. See https://docs.voho.ai/voices
VOHO_VOICE=layla
# sada-1 is faster and the right default for a live call; nabra-1 is more expressive.
VOHO_MODEL=sada-1

# Speech-to-text — the listening half. Voho does not transcribe.
#   twilio  the transcript arrives in the webhook (no extra key needed)
#   openai  Whisper, needs OPENAI_API_KEY
#   custom  your own endpoint at STT_URL, for audio that must stay on-premise
STT_PROVIDER=twilio
STT_LANGUAGE=ar-SA
# OPENAI_API_KEY=
# STT_URL=https://asr.internal.example.sa/transcribe

# Telephony. Only needed for real calls — examples/cli.py runs without them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The address Twilio can reach this app on, e.g. an ngrok URL while developing.
PUBLIC_URL=

# Where the appointments live.
BOOKING_DB=appointments.db
HOLD_SECONDS=180
